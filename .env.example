# === Backend Python (REG-044) ===
# Única fuente de la URL del backend para el proxy /api del panel.
# Sin ella los handlers fallan con 500 claro (no hay fallback).
PYTHON_API_BASE_URL=http://127.0.0.1:8000

# Solo si algún código cliente necesita conocer el origen del API público
# (evitar: las llamadas deben ir por el proxy same-origin /api).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
